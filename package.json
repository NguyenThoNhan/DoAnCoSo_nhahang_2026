{
  "name": "project",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "migrate": "node src/migrations/migrate.js",
    "seed": "node src/migrations/seed.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage --coverageReporters=text --coverageReporters=text-summary --coverageReporters=html --coverageReporters=lcov",
    "test:coverage:nyc": "nyc --reporter=text --reporter=html --reporter=lcov npm run test",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "test:random": "node tests/random/runRandomTests.js",
    "start": "node server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "mysql2": "^3.16.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.11",
    "nyc": "^18.0.0",
    "selenium-webdriver": "^4.44.0",
    "supertest": "^7.2.2"
  },
  "nyc": {
    "include": [
      "src/controllers/**/*.js",
      "src/models/**/*.js"
    ],
    "exclude": [
      "tests/**",
      "coverage/**",
      "node_modules/**"
    ],
    "reporter": [
      "text",
      "text-summary",
      "html",
      "lcov"
    ],
    "report-dir": "coverage",
    "all": true,
    "cache": false
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/unit/**/*.test.js",
      "**/tests/api/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coverageProvider": "v8",
    "collectCoverageFrom": [
      "src/controllers/*.js",
      "src/models/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "lcov"
    ],
    "verbose": true
  }
}
